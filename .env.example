# Copy to .env.local and fill in from your Supabase project settings
# (Project Settings → API). .env.local is gitignored.
#
# The anon key is designed to be shipped to browsers — every table is protected
# by row-level security, so it grants nothing on its own. It still stays out of
# git so rotating it never means rewriting history.
#
# Leave these unset and the app runs in local-only mode: everything works, but
# nothing syncs and sharing is disabled.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional. Enables episode names and stills (the "favorite episode" picker).
# Everything else in the app works without it.
# Get one at https://www.themoviedb.org/settings/api
VITE_TMDB_API_KEY=your-tmdb-key
